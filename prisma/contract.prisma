// use prisma-8

model Movie {
  id          String @id @default(uuid())
  title       String
  description String?
  releaseYear Int?

  createdAt   temporal.createdAtString()
  updatedAt   temporal.updatedAtString()

  genres      MovieGenre[]

  @@map("movies")
}

model Genre {
  id     String @id @default(uuid())
  name   String @unique

  movies MovieGenre[]

  @@map("genres")
}

model MovieGenre {
  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@map("movie_genres")
}